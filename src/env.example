# Lutecia settings. Fill in LUTECIA_TOKEN (Sweeft gives it to you), save this file, close it,
# then double-click Lutecia again. Keep the token private: it gives access to customer data.
#
# Address of the Lutecia server (Sweeft fills it in). Must start with https://
LUTECIA_SERVER=https://
# Your access key:
LUTECIA_TOKEN=
