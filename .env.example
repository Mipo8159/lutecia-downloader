# Copy this file to .env (same folder) and fill in the token. .env is never uploaded to GitHub.
# Address of the Lutecia sync server. For testing on the same computer as the server: http://127.0.0.1:3000
LUTECIA_SERVER=http://127.0.0.1:3000
# The server's SYNC_API_TOKEN. Keep it private: it gives access to customer data.
LUTECIA_TOKEN=
# Optional: where the data goes (default: "Bitrix import" in this folder)
# LUTECIA_FOLDER=Bitrix import
